rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMember(poolId) {
      return exists(/databases/$(database)/documents/pools/$(poolId)/members/$(request.auth.uid));
    }

    function isAdmin(poolId) {
      let role = get(/databases/$(database)/documents/pools/$(poolId)/members/$(request.auth.uid)).data.role;
      return role in ['owner', 'admin'];
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /pools/{poolId} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow read: if signedIn() && isMember(poolId);
      allow update, delete: if signedIn() && isAdmin(poolId);

      match /members/{uid} {
        allow read: if signedIn() && isMember(poolId);
        allow create: if signedIn() && request.auth.uid == uid;
        allow update, delete: if signedIn() && isAdmin(poolId);
      }

      match /predictions/{predictionId} {
        allow read: if signedIn() && isMember(poolId);
        allow create, update: if signedIn() && isMember(poolId) && request.resource.data.uid == request.auth.uid;
        allow delete: if false;
      }

      match /leaderboard/{uid} {
        allow read: if signedIn() && isMember(poolId);
        allow write: if signedIn() && isAdmin(poolId);
      }
    }

    match /matches/{matchId} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
